$TTL 120
@   IN  SOA ns1.domain0036.test. admin.domain0036.test. (
        2026051836 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0036.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.16.34
@       IN  TXT     "env=prod;dept=finance"
intranet    IN  A       10.10.42.140
bank    IN  A       10.10.245.225
bank    IN  A       10.10.66.9
admin    IN  CNAME   portal.domain0036.test.
portal IN  A       10.10.36.103
mail    IN  A       10.10.231.50
_info.mail IN TXT "service=mail;ttl=120"
