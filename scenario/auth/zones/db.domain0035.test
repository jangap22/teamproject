$TTL 120
@   IN  SOA ns1.domain0035.test. admin.domain0035.test. (
        2026051835 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0035.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.165.39
@       IN  TXT     "env=dev;dept=rnd"
login    IN  A       10.10.238.40
login    IN  A       10.10.56.80
mail    IN  A       10.10.99.78
intranet    IN  A       10.10.87.78
intranet    IN  A       10.10.160.117
api    IN  A       10.10.225.162
_info.api IN TXT "service=api;ttl=120"
test    IN  A       10.10.83.199
mail    IN  A       10.10.116.32
@       IN  MX 10   mail.domain0035.test.
