$TTL 600
@   IN  SOA ns1.domain0470.test. admin.domain0470.test. (
        2026051870 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0470.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.210.201
@       IN  TXT     "env=test;dept=hr"
admin    IN  A       10.10.121.198
dev    IN  A       10.10.50.38
www    IN  CNAME   portal.domain0470.test.
portal IN  A       10.10.63.107
test    IN  A       10.10.122.65
mail    IN  A       10.10.146.64
@       IN  MX 10   mail.domain0470.test.
