$TTL 60
@   IN  SOA ns1.domain0712.test. admin.domain0712.test. (
        2026051812 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0712.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.105.26
@       IN  TXT     "env=dev;dept=hr"
intranet    IN  A       10.10.179.138
_info.intranet IN TXT "service=intranet;ttl=60"
mail    IN  A       10.10.30.233
admin    IN  A       10.10.193.204
_info.admin IN TXT "service=admin;ttl=60"
test    IN  A       10.10.231.151
_info.test IN TXT "service=test;ttl=60"
dev    IN  A       10.10.64.204
_info.dev IN TXT "service=dev;ttl=60"
bank    IN  A       10.10.145.245
_info.bank IN TXT "service=bank;ttl=60"
mail    IN  A       10.10.254.248
@       IN  MX 10   mail.domain0712.test.
