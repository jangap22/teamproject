@   IN  SOA ns1.domain0995.test. admin.domain0995.test. (
        2026051895 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0995.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.138.55
