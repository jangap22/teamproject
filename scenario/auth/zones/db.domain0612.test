$TTL 300
@   IN  SOA ns1.domain0612.test. admin.domain0612.test. (
        2026051812 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0612.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.21.13
@       IN  TXT     "env=test;dept=finance"
portal    IN  A       10.10.137.137
_info.portal IN TXT "service=portal;ttl=300"
login    IN  CNAME   www.domain0612.test.
www IN  A       10.10.214.181
mail    IN  CNAME   intranet.domain0612.test.
intranet IN  A       10.10.106.201
bank    IN  A       10.10.47.27
_info.bank IN TXT "service=bank;ttl=300"
