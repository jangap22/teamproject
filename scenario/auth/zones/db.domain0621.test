$TTL 600
@   IN  SOA ns1.domain0621.test. admin.domain0621.test. (
        2026051821 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0621.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.94.173
@       IN  TXT     "env=prod;dept=security"
www    IN  A       10.10.193.85
_info.www IN TXT "service=www;ttl=600"
api    IN  A       10.10.85.180
_info.api IN TXT "service=api;ttl=600"
admin    IN  CNAME   portal.domain0621.test.
portal IN  A       10.10.101.41
intranet    IN  A       10.10.202.28
_info.intranet IN TXT "service=intranet;ttl=600"
mail    IN  A       10.10.5.99
@       IN  MX 10   mail.domain0621.test.
