$TTL 600
@   IN  SOA ns1.domain0614.test. admin.domain0614.test. (
        2026051814 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0614.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.237.125
@       IN  TXT     "env=stage;dept=security"
www    IN  A       10.10.77.117
_info.www IN TXT "service=www;ttl=600"
api    IN  A       10.10.14.106
_info.api IN TXT "service=api;ttl=600"
dev    IN  A       10.10.71.232
dev    IN  A       10.10.144.16
mail    IN  A       10.10.9.73
@       IN  MX 10   mail.domain0614.test.
