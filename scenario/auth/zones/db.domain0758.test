$TTL 120
@   IN  SOA ns1.domain0758.test. admin.domain0758.test. (
        2026051858 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0758.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.185.40
@       IN  TXT     "env=dev;dept=hr"
api    IN  CNAME   portal.domain0758.test.
portal IN  A       10.10.98.64
intranet    IN  CNAME   portal.domain0758.test.
portal IN  A       10.10.25.62
www    IN  A       10.10.50.83
_info.www IN TXT "service=www;ttl=120"
portal    IN  CNAME   intranet.domain0758.test.
intranet IN  A       10.10.213.169
mail    IN  A       10.10.253.21
@       IN  MX 10   mail.domain0758.test.
