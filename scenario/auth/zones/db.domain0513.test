$TTL 60
@   IN  SOA ns1.domain0513.test. admin.domain0513.test. (
        2026051813 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0513.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.180.185
@       IN  TXT     "env=test;dept=rnd"
portal    IN  A       10.10.76.41
_info.portal IN TXT "service=portal;ttl=60"
admin    IN  A       10.10.56.112
dev    IN  A       10.10.194.154
_info.dev IN TXT "service=dev;ttl=60"
intranet    IN  A       10.10.124.250
_info.intranet IN TXT "service=intranet;ttl=60"
mail    IN  A       10.10.137.78
@       IN  MX 10   mail.domain0513.test.
