$TTL 1800
@   IN  SOA ns1.domain0989.test. admin.domain0989.test. (
        2026051889 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0989.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.220.42
@       IN  TXT     "env=dev;dept=infra"
dev    IN  A       10.10.106.181
test    IN  A       10.10.248.243
api    IN  A       10.10.84.226
_info.api IN TXT "service=api;ttl=1800"
portal    IN  CNAME   www.domain0989.test.
www IN  A       10.10.207.171
mail    IN  A       10.10.106.145
@       IN  MX 10   mail.domain0989.test.
