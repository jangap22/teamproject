$TTL 120
@   IN  SOA ns1.domain0977.test. admin.domain0977.test. (
        2026051877 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0977.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.246.126
@       IN  TXT     "env=test;dept=infra"
test    IN  A       10.10.87.138
_info.test IN TXT "service=test;ttl=120"
intranet    IN  A       10.10.38.180
_info.intranet IN TXT "service=intranet;ttl=120"
dev    IN  A       10.10.145.159
dev    IN  A       10.10.217.198
admin    IN  CNAME   www.domain0977.test.
www IN  A       10.10.84.192
bank    IN  A       10.10.107.215
bank    IN  A       10.10.180.253
mail    IN  A       10.10.88.37
@       IN  MX 10   mail.domain0977.test.
