$TTL 1800
@   IN  SOA ns1.domain0573.test. admin.domain0573.test. (
        2026051873 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0573.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.137.36
@       IN  TXT     "env=prod;dept=finance"
api    IN  CNAME   portal.domain0573.test.
portal IN  A       10.10.85.248
admin    IN  A       10.10.166.92
_info.admin IN TXT "service=admin;ttl=1800"
mail    IN  A       10.10.77.40
@       IN  MX 10   mail.domain0573.test.
