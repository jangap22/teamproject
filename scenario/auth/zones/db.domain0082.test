$TTL 120
@   IN  SOA ns1.domain0082.test. admin.domain0082.test. (
        2026051882 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0082.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.41.232
@       IN  TXT     "env=stage;dept=infra"
portal    IN  A       10.10.59.13
_info.portal IN TXT "service=portal;ttl=120"
login    IN  CNAME   intranet.domain0082.test.
intranet IN  A       10.10.149.77
admin    IN  A       10.10.122.147
api    IN  A       10.10.6.193
_info.api IN TXT "service=api;ttl=120"
www    IN  A       10.10.231.160
mail    IN  A       10.10.107.123
@       IN  MX 10   mail.domain0082.test.
