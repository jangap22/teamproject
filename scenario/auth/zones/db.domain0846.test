$TTL 120
@   IN  SOA ns1.domain0846.test. admin.domain0846.test. (
        2026051846 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0846.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.154.131
@       IN  TXT     "env=dev;dept=sales"
www    IN  A       10.10.236.140
_info.www IN TXT "service=www;ttl=120"
admin    IN  A       10.10.111.230
_info.admin IN TXT "service=admin;ttl=120"
mail    IN  A       10.10.16.82
test    IN  A       10.10.9.138
dev    IN  CNAME   portal.domain0846.test.
portal IN  A       10.10.59.14
mail    IN  A       10.10.63.191
@       IN  MX 10   mail.domain0846.test.
