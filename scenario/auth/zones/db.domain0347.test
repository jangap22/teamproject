$TTL 120
@   IN  SOA ns1.domain0347.test. admin.domain0347.test. (
        2026051847 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0347.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.148.167
@       IN  TXT     "env=test;dept=finance"
login    IN  A       10.10.5.103
bank    IN  CNAME   portal.domain0347.test.
portal IN  A       10.10.139.109
portal    IN  CNAME   intranet.domain0347.test.
intranet IN  A       10.10.66.104
test    IN  A       10.10.49.24
_info.test IN TXT "service=test;ttl=120"
mail    IN  A       10.10.184.178
@       IN  MX 10   mail.domain0347.test.
