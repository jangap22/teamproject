$TTL 300
@   IN  SOA ns1.domain0126.test. admin.domain0126.test. (
        2026051826 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0126.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.45.191
@       IN  TXT     "env=stage;dept=rnd"
mail    IN  A       10.10.163.159
_info.mail IN TXT "service=mail;ttl=300"
bank    IN  A       10.10.155.152
_info.bank IN TXT "service=bank;ttl=300"
www    IN  A       10.10.249.169
_info.www IN TXT "service=www;ttl=300"
mail    IN  A       10.10.217.224
@       IN  MX 10   mail.domain0126.test.
