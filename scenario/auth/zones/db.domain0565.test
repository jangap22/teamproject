$TTL 600
@   IN  SOA ns1.domain0565.test. admin.domain0565.test. (
        2026051865 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0565.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.17.204
@       IN  TXT     "env=stage;dept=security"
bank    IN  CNAME   portal.domain0565.test.
portal IN  A       10.10.210.224
test    IN  A       10.10.114.41
intranet    IN  CNAME   www.domain0565.test.
www IN  A       10.10.73.37
api    IN  A       10.10.169.116
dev    IN  CNAME   intranet.domain0565.test.
intranet IN  A       10.10.169.165
login    IN  A       10.10.207.226
_info.login IN TXT "service=login;ttl=600"
mail    IN  A       10.10.8.203
@       IN  MX 10   mail.domain0565.test.
