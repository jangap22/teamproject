$TTL 1800
@   IN  SOA ns1.domain0665.test. admin.domain0665.test. (
        2026051865 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0665.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.204.105
@       IN  TXT     "env=test;dept=security"
portal    IN  CNAME   www.domain0665.test.
www IN  A       10.10.124.218
admin    IN  A       10.10.24.151
_info.admin IN TXT "service=admin;ttl=1800"
