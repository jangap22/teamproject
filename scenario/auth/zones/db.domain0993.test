$TTL 120
@   IN  SOA ns1.domain0993.test. admin.domain0993.test. (
        2026051893 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0993.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.103.52
@       IN  TXT     "env=stage;dept=security"
test    IN  A       10.10.128.168
intranet    IN  A       10.10.46.127
_info.intranet IN TXT "service=intranet;ttl=120"
bank    IN  A       10.10.70.224
bank    IN  A       10.10.145.9
mail    IN  A       10.10.237.91
@       IN  MX 10   mail.domain0993.test.
