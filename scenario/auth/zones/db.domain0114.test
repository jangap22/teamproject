$TTL 300
@   IN  SOA ns1.domain0114.test. admin.domain0114.test. (
        2026051814 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0114.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.144.178
@       IN  TXT     "env=stage;dept=hr"
mail    IN  A       10.10.74.214
admin    IN  A       10.10.221.188
login    IN  A       10.10.7.53
_info.login IN TXT "service=login;ttl=300"
