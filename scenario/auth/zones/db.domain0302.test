$TTL 120
@   IN  SOA ns1.domain0302.test. admin.domain0302.test. (
        2026051802 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0302.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.20.238
@       IN  TXT     "env=test;dept=sales"
www    IN  A       10.10.139.129
_info.www IN TXT "service=www;ttl=120"
test    IN  CNAME   intranet.domain0302.test.
intranet IN  A       10.10.17.20
admin    IN  A       10.10.83.219
_info.admin IN TXT "service=admin;ttl=120"
mail    IN  A       10.10.199.217
@       IN  MX 10   mail.domain0302.test.
