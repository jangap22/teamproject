$TTL 300
@   IN  SOA ns1.domain0460.test. admin.domain0460.test. (
        2026051860 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0460.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.145.113
@       IN  TXT     "env=dev;dept=rnd"
mail    IN  A       10.10.251.98
bank    IN  A       10.10.228.135
_info.bank IN TXT "service=bank;ttl=300"
www    IN  CNAME   portal.domain0460.test.
portal IN  A       10.10.224.220
admin    IN  A       10.10.45.197
