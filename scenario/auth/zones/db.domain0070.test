$TTL 60
@   IN  SOA ns1.domain0070.test. admin.domain0070.test. (
        2026051870 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0070.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.178.157
@       IN  TXT     "env=dev;dept=infra"
admin    IN  A       10.10.8.91
dev    IN  A       10.10.124.76
test    IN  A       10.10.251.168
bank    IN  CNAME   www.domain0070.test.
www IN  A       10.10.194.212
mail    IN  A       10.10.100.25
@       IN  MX 10   mail.domain0070.test.
