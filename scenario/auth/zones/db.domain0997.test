$TTL 120
@   IN  SOA ns1.domain0997.test. admin.domain0997.test. (
        2026051897 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0997.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.68.128
@       IN  TXT     "env=stage;dept=security"
mail    IN  CNAME   www.domain0997.test.
www IN  A       10.10.58.155
bank    IN  A       10.10.207.221
bank    IN  A       10.10.25.8
admin    IN  A       10.10.161.5
_info.admin IN TXT "service=admin;ttl=120"
mail    IN  A       10.10.154.96
@       IN  MX 10   mail.domain0997.test.
