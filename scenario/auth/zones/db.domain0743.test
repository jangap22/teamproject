$TTL 120
@   IN  SOA ns1.domain0743.test. admin.domain0743.test. (
        2026051843 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0743.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.124.108
@       IN  TXT     "env=test;dept=infra"
test    IN  A       10.10.174.132
_info.test IN TXT "service=test;ttl=120"
intranet    IN  A       10.10.244.223
bank    IN  A       10.10.108.221
admin    IN  CNAME   portal.domain0743.test.
portal IN  A       10.10.248.136
