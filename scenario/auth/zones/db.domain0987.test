$TTL 600
@   IN  SOA ns1.domain0987.test. admin.domain0987.test. (
        2026051887 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0987.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.27.244
@       IN  TXT     "env=dev;dept=rnd"
intranet    IN  A       10.10.96.97
intranet    IN  A       10.10.168.138
www    IN  A       10.10.122.175
www    IN  A       10.10.194.216
test    IN  A       10.10.86.234
_info.test IN TXT "service=test;ttl=600"
admin    IN  A       10.10.13.39
_info.admin IN TXT "service=admin;ttl=600"
dev    IN  CNAME   www.domain0987.test.
www IN  A       10.10.32.67
mail    IN  A       10.10.230.215
@       IN  MX 10   mail.domain0987.test.
