$TTL 600
@   IN  SOA ns1.domain0443.test. admin.domain0443.test. (
        2026051843 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0443.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.118.201
@       IN  TXT     "env=prod;dept=sales"
api    IN  CNAME   intranet.domain0443.test.
intranet IN  A       10.10.229.6
www    IN  A       10.10.52.31
_info.www IN TXT "service=www;ttl=600"
login    IN  A       10.10.145.190
_info.login IN TXT "service=login;ttl=600"
mail    IN  A       10.10.44.218
@       IN  MX 10   mail.domain0443.test.
