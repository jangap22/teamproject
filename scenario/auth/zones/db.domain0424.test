$TTL 1800
@   IN  SOA ns1.domain0424.test. admin.domain0424.test. (
        2026051824 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0424.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.50.128
@       IN  TXT     "env=prod;dept=infra"
dev    IN  A       10.10.245.35
www    IN  A       10.10.71.233
_info.www IN TXT "service=www;ttl=1800"
test    IN  A       10.10.83.245
mail    IN  A       10.10.127.91
@       IN  MX 10   mail.domain0424.test.
