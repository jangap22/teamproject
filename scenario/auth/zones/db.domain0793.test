$TTL 1800
@   IN  SOA ns1.domain0793.test. admin.domain0793.test. (
        2026051893 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0793.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.87.147
@       IN  TXT     "env=test;dept=infra"
login    IN  A       10.10.101.71
_info.login IN TXT "service=login;ttl=1800"
bank    IN  A       10.10.127.25
intranet    IN  A       10.10.108.210
intranet    IN  A       10.10.180.249
admin    IN  A       10.10.180.32
_info.admin IN TXT "service=admin;ttl=1800"
www    IN  A       10.10.28.106
_info.www IN TXT "service=www;ttl=1800"
test    IN  A       10.10.245.206
_info.test IN TXT "service=test;ttl=1800"
mail    IN  A       10.10.45.142
@       IN  MX 10   mail.domain0793.test.
