$TTL 120
@   IN  SOA ns1.domain0650.test. admin.domain0650.test. (
        2026051850 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0650.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.233.239
@       IN  TXT     "env=dev;dept=finance"
portal    IN  CNAME   www.domain0650.test.
www IN  A       10.10.247.128
test    IN  A       10.10.235.117
_info.test IN TXT "service=test;ttl=120"
mail    IN  CNAME   www.domain0650.test.
www IN  A       10.10.110.174
