test    IN  CNAME   portal.domain0193.test.
portal IN  A       10.10.230.182
admin    IN  CNAME   intranet.domain0193.test.
intranet IN  A       10.10.193.72
login    IN  CNAME   portal.domain0193.test.
portal IN  A       10.10.183.144
www    IN  A       10.10.30.77
www    IN  A       10.10.102.115
intranet    IN  A       10.10.101.28
_info.intranet IN TXT "service=intranet;ttl=120"
