$TTL 120
@   IN  SOA ns1.domain0193.test. admin.domain0193.test. (
        2026051893 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0193.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.55.49
