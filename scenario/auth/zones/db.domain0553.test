@   IN  SOA ns1.domain0553.test. admin.domain0553.test. (
        2026051853 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0553.test.
