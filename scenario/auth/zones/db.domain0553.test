_info.test IN TXT "service=test;ttl=1800"
mail    IN  A       10.10.83.118
intranet    IN  A       10.10.148.226
_info.intranet IN TXT "service=intranet;ttl=1800"
api    IN  A       10.10.67.184
_info.api IN TXT "service=api;ttl=1800"
admin    IN  A       10.10.166.108
mail    IN  A       10.10.45.109
@       IN  MX 10   mail.domain0553.test.
