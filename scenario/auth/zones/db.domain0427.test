$TTL 300
@   IN  SOA ns1.domain0427.test. admin.domain0427.test. (
        2026051827 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0427.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.62.42
@       IN  TXT     "env=test;dept=rnd"
dev    IN  A       10.10.184.23
_info.dev IN TXT "service=dev;ttl=300"
mail    IN  A       10.10.47.226
www    IN  A       10.10.66.249
portal    IN  A       10.10.228.174
_info.portal IN TXT "service=portal;ttl=300"
test    IN  A       10.10.182.236
intranet    IN  A       10.10.57.192
mail    IN  A       10.10.9.103
@       IN  MX 10   mail.domain0427.test.
