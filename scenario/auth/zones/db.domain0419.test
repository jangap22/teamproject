$TTL 300
@   IN  SOA ns1.domain0419.test. admin.domain0419.test. (
        2026051819 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0419.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.81.38
@       IN  TXT     "env=test;dept=rnd"
portal    IN  CNAME   www.domain0419.test.
www IN  A       10.10.35.77
bank    IN  A       10.10.144.248
_info.bank IN TXT "service=bank;ttl=300"
admin    IN  A       10.10.128.63
_info.admin IN TXT "service=admin;ttl=300"
