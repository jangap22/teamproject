$TTL 120
@   IN  SOA ns1.domain0705.test. admin.domain0705.test. (
        2026051805 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0705.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.39.99
@       IN  TXT     "env=test;dept=infra"
www    IN  CNAME   intranet.domain0705.test.
intranet IN  A       10.10.249.141
admin    IN  A       10.10.206.222
admin    IN  A       10.10.24.6
bank    IN  A       10.10.172.212
_info.bank IN TXT "service=bank;ttl=120"
login    IN  A       10.10.11.28
