$TTL 120
@   IN  SOA ns1.domain0738.test. admin.domain0738.test. (
        2026051838 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0738.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.153.141
@       IN  TXT     "env=dev;dept=rnd"
portal    IN  A       10.10.137.136
_info.portal IN TXT "service=portal;ttl=120"
bank    IN  A       10.10.238.112
admin    IN  CNAME   intranet.domain0738.test.
intranet IN  A       10.10.101.215
mail    IN  A       10.10.232.113
@       IN  MX 10   mail.domain0738.test.
