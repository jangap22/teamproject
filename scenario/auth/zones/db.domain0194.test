$TTL 600
@   IN  SOA ns1.domain0194.test. admin.domain0194.test. (
        2026051894 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0194.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.77.191
@       IN  TXT     "env=prod;dept=finance"
api    IN  A       10.10.162.100
mail    IN  A       10.10.56.151
_info.mail IN TXT "service=mail;ttl=600"
portal    IN  A       10.10.134.40
