$TTL 600
@   IN  SOA ns1.domain0041.test. admin.domain0041.test. (
        2026051841 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0041.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.87.5
@       IN  TXT     "env=stage;dept=finance"
test    IN  A       10.10.228.77
_info.test IN TXT "service=test;ttl=600"
admin    IN  A       10.10.64.173
_info.admin IN TXT "service=admin;ttl=600"
dev    IN  A       10.10.227.184
dev    IN  A       10.10.47.224
intranet    IN  A       10.10.165.146
_info.intranet IN TXT "service=intranet;ttl=600"
