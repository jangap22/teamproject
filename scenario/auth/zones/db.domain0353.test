$TTL 600
@   IN  SOA ns1.domain0353.test. admin.domain0353.test. (
        2026051853 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0353.test.
