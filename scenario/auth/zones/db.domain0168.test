$TTL 1800
@   IN  SOA ns1.domain0168.test. admin.domain0168.test. (
        2026051868 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0168.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.118.191
