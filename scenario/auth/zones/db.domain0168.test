mail    IN  A       10.10.191.99
test    IN  A       10.10.92.12
dev    IN  A       10.10.72.186
_info.dev IN TXT "service=dev;ttl=1800"
www    IN  A       10.10.62.225
bank    IN  A       10.10.168.8
bank    IN  A       10.10.240.49
admin    IN  A       10.10.91.161
_info.admin IN TXT "service=admin;ttl=1800"
