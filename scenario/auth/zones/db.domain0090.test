$TTL 120
@   IN  SOA ns1.domain0090.test. admin.domain0090.test. (
        2026051890 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0090.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.172.216
@       IN  TXT     "env=prod;dept=finance"
intranet    IN  A       10.10.44.173
intranet    IN  A       10.10.190.253
login    IN  A       10.10.83.43
_info.login IN TXT "service=login;ttl=120"
portal    IN  CNAME   intranet.domain0090.test.
intranet IN  A       10.10.13.34
mail    IN  A       10.10.213.73
@       IN  MX 10   mail.domain0090.test.
