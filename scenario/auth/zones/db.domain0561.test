$TTL 600
@   IN  SOA ns1.domain0561.test. admin.domain0561.test. (
        2026051861 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0561.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.243.199
@       IN  TXT     "env=stage;dept=security"
login    IN  A       10.10.80.125
dev    IN  A       10.10.215.136
portal    IN  A       10.10.112.83
portal    IN  A       10.10.187.122
www    IN  A       10.10.160.194
www    IN  A       10.10.234.233
intranet    IN  CNAME   intranet.domain0561.test.
intranet IN  A       10.10.192.97
test    IN  A       10.10.84.227
_info.test IN TXT "service=test;ttl=600"
api    IN  CNAME   www.domain0561.test.
www IN  A       10.10.101.251
mail    IN  A       10.10.80.99
@       IN  MX 10   mail.domain0561.test.
