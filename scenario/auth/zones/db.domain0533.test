_info.login IN TXT "service=login;ttl=120"
intranet    IN  A       10.10.175.11
intranet    IN  A       10.10.248.50
bank    IN  A       10.10.251.32
test    IN  A       10.10.46.157
www    IN  A       10.10.239.182
