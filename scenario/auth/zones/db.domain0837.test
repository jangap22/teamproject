$TTL 600
@   IN  SOA ns1.domain0837.test. admin.domain0837.test. (
        2026051837 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0837.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.112.46
@       IN  TXT     "env=prod;dept=infra"
test    IN  CNAME   intranet.domain0837.test.
intranet IN  A       10.10.83.142
www    IN  A       10.10.57.226
bank    IN  A       10.10.209.46
mail    IN  A       10.10.99.160
_info.mail IN TXT "service=mail;ttl=600"
mail    IN  A       10.10.206.45
@       IN  MX 10   mail.domain0837.test.
