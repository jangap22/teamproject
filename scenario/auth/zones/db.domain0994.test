$TTL 1800
@   IN  SOA ns1.domain0994.test. admin.domain0994.test. (
        2026051894 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0994.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.74.122
@       IN  TXT     "env=test;dept=rnd"
intranet    IN  A       10.10.122.131
admin    IN  A       10.10.41.46
www    IN  A       10.10.21.131
_info.www IN TXT "service=www;ttl=1800"
dev    IN  A       10.10.249.246
login    IN  A       10.10.138.132
_info.login IN TXT "service=login;ttl=1800"
