$TTL 300
@   IN  SOA ns1.domain0950.test. admin.domain0950.test. (
        2026051850 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0950.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.192.58
