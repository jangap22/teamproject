login    IN  A       10.10.185.38
login    IN  A       10.10.3.78
intranet    IN  A       10.10.139.107
intranet    IN  A       10.10.213.148
admin    IN  A       10.10.57.35
admin    IN  A       10.10.130.75
dev    IN  A       10.10.84.195
mail    IN  A       10.10.201.102
@       IN  MX 10   mail.domain0950.test.
