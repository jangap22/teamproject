$TTL 300
@   IN  SOA ns1.domain0244.test. admin.domain0244.test. (
        2026051844 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0244.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.156.25
@       IN  TXT     "env=test;dept=finance"
dev    IN  A       10.10.37.179
_info.dev IN TXT "service=dev;ttl=300"
login    IN  CNAME   portal.domain0244.test.
portal IN  A       10.10.14.108
portal    IN  CNAME   www.domain0244.test.
www IN  A       10.10.46.95
test    IN  A       10.10.135.46
_info.test IN TXT "service=test;ttl=300"
intranet    IN  A       10.10.185.104
_info.intranet IN TXT "service=intranet;ttl=300"
admin    IN  A       10.10.91.128
