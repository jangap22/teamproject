$TTL 600
@   IN  SOA ns1.domain0771.test. admin.domain0771.test. (
        2026051871 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0771.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.243.72
@       IN  TXT     "env=test;dept=hr"
admin    IN  A       10.10.225.113
login    IN  A       10.10.112.130
www    IN  A       10.10.198.111
test    IN  A       10.10.65.15
_info.test IN TXT "service=test;ttl=600"
dev    IN  A       10.10.70.217
_info.dev IN TXT "service=dev;ttl=600"
