$TTL 60
@   IN  SOA ns1.domain0401.test. admin.domain0401.test. (
        2026051801 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0401.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.42.62
@       IN  TXT     "env=dev;dept=hr"
test    IN  CNAME   intranet.domain0401.test.
intranet IN  A       10.10.205.107
mail    IN  A       10.10.24.117
_info.mail IN TXT "service=mail;ttl=60"
dev    IN  A       10.10.101.229
portal    IN  A       10.10.174.112
mail    IN  A       10.10.45.228
@       IN  MX 10   mail.domain0401.test.
