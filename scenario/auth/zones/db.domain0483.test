$TTL 300
@   IN  SOA ns1.domain0483.test. admin.domain0483.test. (
        2026051883 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0483.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.104.36
@       IN  TXT     "env=prod;dept=sales"
test    IN  CNAME   www.domain0483.test.
www IN  A       10.10.67.181
www    IN  A       10.10.203.26
portal    IN  CNAME   portal.domain0483.test.
portal IN  A       10.10.190.55
intranet    IN  CNAME   www.domain0483.test.
www IN  A       10.10.66.162
bank    IN  A       10.10.200.243
_info.bank IN TXT "service=bank;ttl=300"
mail    IN  A       10.10.24.23
@       IN  MX 10   mail.domain0483.test.
