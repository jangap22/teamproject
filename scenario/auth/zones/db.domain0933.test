$TTL 1800
@   IN  SOA ns1.domain0933.test. admin.domain0933.test. (
        2026051833 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0933.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.66.26
@       IN  TXT     "env=stage;dept=finance"
login    IN  A       10.10.170.144
_info.login IN TXT "service=login;ttl=1800"
admin    IN  A       10.10.91.50
_info.admin IN TXT "service=admin;ttl=1800"
mail    IN  CNAME   intranet.domain0933.test.
intranet IN  A       10.10.136.89
mail    IN  A       10.10.130.59
@       IN  MX 10   mail.domain0933.test.
