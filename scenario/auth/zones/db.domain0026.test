$TTL 60
@   IN  SOA ns1.domain0026.test. admin.domain0026.test. (
        2026051826 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0026.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.89.43
@       IN  TXT     "env=dev;dept=infra"
admin    IN  A       10.10.13.146
_info.admin IN TXT "service=admin;ttl=60"
mail    IN  CNAME   intranet.domain0026.test.
intranet IN  A       10.10.206.181
api    IN  A       10.10.14.57
