$TTL 300
@   IN  SOA ns1.domain0021.test. admin.domain0021.test. (
        2026051821 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0021.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.14.48
@       IN  TXT     "env=prod;dept=rnd"
test    IN  A       10.10.53.200
login    IN  A       10.10.182.160
_info.login IN TXT "service=login;ttl=300"
mail    IN  A       10.10.210.155
@       IN  MX 10   mail.domain0021.test.
