$TTL 600
@   IN  SOA ns1.domain0156.test. admin.domain0156.test. (
        2026051856 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0156.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.24.137
@       IN  TXT     "env=prod;dept=rnd"
bank    IN  A       10.10.68.236
www    IN  A       10.10.144.74
intranet    IN  A       10.10.52.98
admin    IN  A       10.10.141.27
dev    IN  A       10.10.139.147
_info.dev IN TXT "service=dev;ttl=600"
login    IN  CNAME   www.domain0156.test.
www IN  A       10.10.146.224
portal    IN  A       10.10.250.197
