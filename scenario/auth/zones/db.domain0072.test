$TTL 60
@   IN  SOA ns1.domain0072.test. admin.domain0072.test. (
        2026051872 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0072.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.23.134
@       IN  TXT     "env=stage;dept=security"
dev    IN  A       10.10.167.212
www    IN  A       10.10.51.144
login    IN  CNAME   intranet.domain0072.test.
intranet IN  A       10.10.124.179
portal    IN  CNAME   intranet.domain0072.test.
intranet IN  A       10.10.79.9
mail    IN  A       10.10.224.43
@       IN  MX 10   mail.domain0072.test.
