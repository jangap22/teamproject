$TTL 600
@   IN  SOA ns1.domain0184.test. admin.domain0184.test. (
        2026051884 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0184.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.6.17
@       IN  TXT     "env=test;dept=finance"
portal    IN  A       10.10.213.119
api    IN  A       10.10.183.64
api    IN  A       10.10.1.104
dev    IN  A       10.10.16.152
dev    IN  A       10.10.88.192
intranet    IN  A       10.10.205.80
_info.intranet IN TXT "service=intranet;ttl=600"
www    IN  A       10.10.160.36
_info.www IN TXT "service=www;ttl=600"
admin    IN  A       10.10.184.51
admin    IN  A       10.10.4.89
mail    IN  A       10.10.84.6
@       IN  MX 10   mail.domain0184.test.
