$TTL 120
@   IN  SOA ns1.domain0980.test. admin.domain0980.test. (
        2026051880 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0980.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.98.156
@       IN  TXT     "env=dev;dept=security"
dev    IN  A       10.10.106.190
admin    IN  A       10.10.95.27
_info.admin IN TXT "service=admin;ttl=120"
portal    IN  A       10.10.253.130
mail    IN  A       10.10.170.215
mail    IN  A       10.10.244.2
intranet    IN  A       10.10.141.250
intranet    IN  A       10.10.215.37
login    IN  A       10.10.25.51
login    IN  A       10.10.97.89
