mail    IN  A       10.10.151.61
mail    IN  A       10.10.226.99
admin    IN  A       10.10.59.66
_info.admin IN TXT "service=admin;ttl=60"
www    IN  A       10.10.94.161
_info.www IN TXT "service=www;ttl=60"
