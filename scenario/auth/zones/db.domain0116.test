$TTL 120
@   IN  SOA ns1.domain0116.test. admin.domain0116.test. (
        2026051816 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0116.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.217.224
@       IN  TXT     "env=stage;dept=finance"
admin    IN  A       10.10.61.238
bank    IN  A       10.10.155.161
_info.bank IN TXT "service=bank;ttl=120"
portal    IN  CNAME   www.domain0116.test.
www IN  A       10.10.218.129
mail    IN  A       10.10.35.199
@       IN  MX 10   mail.domain0116.test.
