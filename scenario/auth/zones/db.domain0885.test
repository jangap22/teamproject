$TTL 120
@   IN  SOA ns1.domain0885.test. admin.domain0885.test. (
        2026051885 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0885.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.234.36
@       IN  TXT     "env=test;dept=hr"
test    IN  A       10.10.37.144
_info.test IN TXT "service=test;ttl=120"
mail    IN  A       10.10.200.189
_info.mail IN TXT "service=mail;ttl=120"
admin    IN  A       10.10.58.21
_info.admin IN TXT "service=admin;ttl=120"
login    IN  A       10.10.212.14
_info.login IN TXT "service=login;ttl=120"
mail    IN  A       10.10.18.76
@       IN  MX 10   mail.domain0885.test.
