$TTL 1800
@   IN  SOA ns1.domain0467.test. admin.domain0467.test. (
        2026051867 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0467.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.41.3
@       IN  TXT     "env=test;dept=rnd"
intranet    IN  A       10.10.74.72
_info.intranet IN TXT "service=intranet;ttl=1800"
api    IN  A       10.10.80.137
_info.api IN TXT "service=api;ttl=1800"
admin    IN  A       10.10.32.157
admin    IN  A       10.10.106.196
mail    IN  A       10.10.79.205
@       IN  MX 10   mail.domain0467.test.
