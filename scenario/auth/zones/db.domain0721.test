$TTL 600
@   IN  SOA ns1.domain0721.test. admin.domain0721.test. (
        2026051821 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0721.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.118.88
@       IN  TXT     "env=stage;dept=security"
admin    IN  A       10.10.24.133
_info.admin IN TXT "service=admin;ttl=600"
intranet    IN  A       10.10.182.221
_info.intranet IN TXT "service=intranet;ttl=600"
portal    IN  CNAME   www.domain0721.test.
www IN  A       10.10.157.168
dev    IN  A       10.10.133.173
