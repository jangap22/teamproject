$TTL 1800
@   IN  SOA ns1.domain0678.test. admin.domain0678.test. (
        2026051878 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0678.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.25.72
@       IN  TXT     "env=dev;dept=infra"
admin    IN  CNAME   www.domain0678.test.
www IN  A       10.10.166.89
dev    IN  A       10.10.48.221
dev    IN  A       10.10.120.8
intranet    IN  A       10.10.243.147
intranet    IN  A       10.10.64.185
test    IN  A       10.10.162.124
_info.test IN TXT "service=test;ttl=1800"
mail    IN  A       10.10.15.102
@       IN  MX 10   mail.domain0678.test.
