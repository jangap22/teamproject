$TTL 1800
@   IN  SOA ns1.domain0486.test. admin.domain0486.test. (
        2026051886 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0486.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.213.101
@       IN  TXT     "env=stage;dept=rnd"
test    IN  CNAME   www.domain0486.test.
www IN  A       10.10.123.246
www    IN  A       10.10.23.33
_info.www IN TXT "service=www;ttl=1800"
mail    IN  A       10.10.131.26
@       IN  MX 10   mail.domain0486.test.
