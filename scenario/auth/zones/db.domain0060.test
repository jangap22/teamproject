$TTL 1800
@   IN  SOA ns1.domain0060.test. admin.domain0060.test. (
        2026051860 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0060.test.
