$TTL 600
@   IN  SOA ns1.domain0296.test. admin.domain0296.test. (
        2026051896 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0296.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.242.171
@       IN  TXT     "env=dev;dept=rnd"
test    IN  A       10.10.174.246
_info.test IN TXT "service=test;ttl=600"
bank    IN  A       10.10.232.102
_info.bank IN TXT "service=bank;ttl=600"
mail    IN  A       10.10.228.60
_info.mail IN TXT "service=mail;ttl=600"
mail    IN  A       10.10.141.205
@       IN  MX 10   mail.domain0296.test.
