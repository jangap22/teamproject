_info.login IN TXT "service=login;ttl=300"
api    IN  A       10.10.201.94
_info.api IN TXT "service=api;ttl=300"
www    IN  CNAME   portal.domain0342.test.
portal IN  A       10.10.111.112
test    IN  A       10.10.158.74
test    IN  A       10.10.232.115
dev    IN  A       10.10.8.241
dev    IN  A       10.10.82.26
