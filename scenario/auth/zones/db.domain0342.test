$TTL 300
@   IN  SOA ns1.domain0342.test. admin.domain0342.test. (
        2026051842 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0342.test.
