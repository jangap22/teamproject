login    IN  CNAME   portal.domain0489.test.
portal IN  A       10.10.155.181
mail    IN  A       10.10.136.178
admin    IN  A       10.10.198.97
www    IN  CNAME   www.domain0489.test.
www IN  A       10.10.5.102
mail    IN  A       10.10.218.242
@       IN  MX 10   mail.domain0489.test.
