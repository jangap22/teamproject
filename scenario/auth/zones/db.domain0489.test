$TTL 120
@   IN  SOA ns1.domain0489.test. admin.domain0489.test. (
        2026051889 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0489.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.212.129
