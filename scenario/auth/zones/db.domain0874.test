$TTL 300
@   IN  SOA ns1.domain0874.test. admin.domain0874.test. (
        2026051874 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0874.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.14.22
@       IN  TXT     "env=stage;dept=security"
api    IN  A       10.10.178.161
intranet    IN  A       10.10.45.66
admin    IN  A       10.10.163.223
_info.admin IN TXT "service=admin;ttl=300"
mail    IN  A       10.10.57.178
@       IN  MX 10   mail.domain0874.test.
