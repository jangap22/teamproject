$TTL 300
@   IN  SOA ns1.domain0016.test. admin.domain0016.test. (
        2026051816 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0016.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.210.46
