$TTL 600
@   IN  SOA ns1.domain0964.test. admin.domain0964.test. (
        2026051864 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0964.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.159.29
@       IN  TXT     "env=prod;dept=security"
dev    IN  A       10.10.121.23
_info.dev IN TXT "service=dev;ttl=600"
api    IN  CNAME   portal.domain0964.test.
portal IN  A       10.10.237.50
mail    IN  A       10.10.39.73
mail    IN  A       10.10.111.113
test    IN  CNAME   www.domain0964.test.
www IN  A       10.10.21.128
