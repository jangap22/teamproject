api    IN  A       10.10.124.82
_info.api IN TXT "service=api;ttl=60"
bank    IN  A       10.10.76.101
dev    IN  CNAME   portal.domain0626.test.
portal IN  A       10.10.234.241
test    IN  CNAME   portal.domain0626.test.
portal IN  A       10.10.223.122
