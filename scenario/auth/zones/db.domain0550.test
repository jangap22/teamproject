$TTL 600
@   IN  SOA ns1.domain0550.test. admin.domain0550.test. (
        2026051850 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0550.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.33.209
@       IN  TXT     "env=dev;dept=rnd"
login    IN  CNAME   intranet.domain0550.test.
intranet IN  A       10.10.202.99
intranet    IN  CNAME   intranet.domain0550.test.
intranet IN  A       10.10.109.226
portal    IN  CNAME   portal.domain0550.test.
portal IN  A       10.10.81.35
www    IN  A       10.10.173.170
_info.www IN TXT "service=www;ttl=600"
dev    IN  A       10.10.122.56
dev    IN  A       10.10.196.95
mail    IN  A       10.10.75.172
@       IN  MX 10   mail.domain0550.test.
