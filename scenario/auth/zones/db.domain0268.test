$TTL 600
@   IN  SOA ns1.domain0268.test. admin.domain0268.test. (
        2026051868 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0268.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.106.225
@       IN  TXT     "env=dev;dept=security"
portal    IN  A       10.10.174.202
dev    IN  A       10.10.61.148
_info.dev IN TXT "service=dev;ttl=600"
test    IN  A       10.10.74.103
_info.test IN TXT "service=test;ttl=600"
mail    IN  A       10.10.22.246
@       IN  MX 10   mail.domain0268.test.
