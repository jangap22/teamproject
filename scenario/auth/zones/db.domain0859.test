$TTL 600
@   IN  SOA ns1.domain0859.test. admin.domain0859.test. (
        2026051859 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0859.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.182.148
@       IN  TXT     "env=test;dept=infra"
portal    IN  A       10.10.105.41
_info.portal IN TXT "service=portal;ttl=600"
login    IN  A       10.10.109.218
admin    IN  A       10.10.100.178
bank    IN  A       10.10.125.155
mail    IN  A       10.10.136.32
@       IN  MX 10   mail.domain0859.test.
