$TTL 120
@   IN  SOA ns1.domain0171.test. admin.domain0171.test. (
        2026051871 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0171.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.137.209
@       IN  TXT     "env=test;dept=infra"
portal    IN  A       10.10.214.184
api    IN  A       10.10.100.218
_info.api IN TXT "service=api;ttl=120"
admin    IN  A       10.10.202.225
_info.admin IN TXT "service=admin;ttl=120"
bank    IN  A       10.10.23.99
