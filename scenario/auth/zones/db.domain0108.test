$TTL 120
@   IN  SOA ns1.domain0108.test. admin.domain0108.test. (
        2026051808 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0108.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.118.249
@       IN  TXT     "env=dev;dept=security"
test    IN  CNAME   portal.domain0108.test.
portal IN  A       10.10.162.56
intranet    IN  A       10.10.8.252
intranet    IN  A       10.10.80.39
dev    IN  A       10.10.12.76
api    IN  A       10.10.117.97
_info.api IN TXT "service=api;ttl=120"
login    IN  A       10.10.205.116
_info.login IN TXT "service=login;ttl=120"
mail    IN  A       10.10.35.18
_info.mail IN TXT "service=mail;ttl=120"
mail    IN  A       10.10.187.161
@       IN  MX 10   mail.domain0108.test.
