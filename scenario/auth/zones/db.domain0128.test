$TTL 1800
@   IN  SOA ns1.domain0128.test. admin.domain0128.test. (
        2026051828 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0128.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.208.101
@       IN  TXT     "env=dev;dept=security"
dev    IN  A       10.10.209.140
portal    IN  A       10.10.247.185
api    IN  CNAME   www.domain0128.test.
www IN  A       10.10.139.3
bank    IN  A       10.10.240.183
_info.bank IN TXT "service=bank;ttl=1800"
mail    IN  A       10.10.231.141
@       IN  MX 10   mail.domain0128.test.
