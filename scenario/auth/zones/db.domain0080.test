$TTL 300
@   IN  SOA ns1.domain0080.test. admin.domain0080.test. (
        2026051880 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0080.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.246.103
@       IN  TXT     "env=dev;dept=sales"
admin    IN  A       10.10.149.172
bank    IN  A       10.10.129.113
intranet    IN  A       10.10.137.143
intranet    IN  A       10.10.30.223
dev    IN  A       10.10.20.62
_info.dev IN TXT "service=dev;ttl=300"
mail    IN  CNAME   portal.domain0080.test.
portal IN  A       10.10.66.172
mail    IN  A       10.10.52.122
@       IN  MX 10   mail.domain0080.test.
