bank    IN  CNAME   www.domain0165.test.
www IN  A       10.10.202.107
dev    IN  CNAME   www.domain0165.test.
www IN  A       10.10.150.197
test    IN  A       10.10.13.15
test    IN  A       10.10.85.56
intranet    IN  A       10.10.227.15
_info.intranet IN TXT "service=intranet;ttl=600"
www    IN  A       10.10.253.119
_info.www IN TXT "service=www;ttl=600"
portal    IN  CNAME   www.domain0165.test.
www IN  A       10.10.63.140
