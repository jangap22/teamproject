$TTL 300
@   IN  SOA ns1.domain0562.test. admin.domain0562.test. (
        2026051862 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0562.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.83.33
@       IN  TXT     "env=test;dept=hr"
admin    IN  A       10.10.225.124
api    IN  A       10.10.144.197
api    IN  A       10.10.216.238
login    IN  A       10.10.103.250
_info.login IN TXT "service=login;ttl=300"
www    IN  A       10.10.185.16
www    IN  A       10.10.3.57
mail    IN  A       10.10.165.254
@       IN  MX 10   mail.domain0562.test.
