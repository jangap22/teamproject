$TTL 1800
@   IN  SOA ns1.domain0834.test. admin.domain0834.test. (
        2026051834 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0834.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.211.195
@       IN  TXT     "env=prod;dept=finance"
portal    IN  A       10.10.64.240
intranet    IN  A       10.10.4.226
dev    IN  A       10.10.17.252
_info.dev IN TXT "service=dev;ttl=1800"
bank    IN  CNAME   www.domain0834.test.
www IN  A       10.10.1.29
mail    IN  A       10.10.202.182
@       IN  MX 10   mail.domain0834.test.
