$TTL 300
@   IN  SOA ns1.domain0130.test. admin.domain0130.test. (
        2026051830 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0130.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.103.128
@       IN  TXT     "env=test;dept=rnd"
bank    IN  A       10.10.220.54
bank    IN  A       10.10.40.93
www    IN  A       10.10.205.138
_info.www IN TXT "service=www;ttl=300"
api    IN  CNAME   intranet.domain0130.test.
intranet IN  A       10.10.211.166
mail    IN  A       10.10.153.94
@       IN  MX 10   mail.domain0130.test.
