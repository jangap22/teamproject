$TTL 300
@   IN  SOA ns1.domain0598.test. admin.domain0598.test. (
        2026051898 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0598.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.118.211
@       IN  TXT     "env=prod;dept=finance"
mail    IN  A       10.10.45.247
login    IN  A       10.10.41.204
_info.login IN TXT "service=login;ttl=300"
mail    IN  A       10.10.140.44
@       IN  MX 10   mail.domain0598.test.
