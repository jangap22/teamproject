$TTL 300
@   IN  SOA ns1.domain0289.test. admin.domain0289.test. (
        2026051889 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0289.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.246.186
@       IN  TXT     "env=test;dept=security"
bank    IN  A       10.10.234.68
intranet    IN  CNAME   www.domain0289.test.
www IN  A       10.10.117.59
login    IN  CNAME   portal.domain0289.test.
portal IN  A       10.10.207.106
www    IN  A       10.10.29.8
_info.www IN TXT "service=www;ttl=300"
mail    IN  A       10.10.252.125
@       IN  MX 10   mail.domain0289.test.
