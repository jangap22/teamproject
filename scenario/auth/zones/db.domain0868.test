$TTL 600
@   IN  SOA ns1.domain0868.test. admin.domain0868.test. (
        2026051868 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0868.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.212.120
@       IN  TXT     "env=dev;dept=rnd"
bank    IN  CNAME   www.domain0868.test.
www IN  A       10.10.23.13
admin    IN  A       10.10.33.51
_info.admin IN TXT "service=admin;ttl=600"
intranet    IN  A       10.10.138.158
intranet    IN  A       10.10.211.196
login    IN  A       10.10.23.28
mail    IN  A       10.10.172.61
@       IN  MX 10   mail.domain0868.test.
