$TTL 60
@   IN  SOA ns1.domain0309.test. admin.domain0309.test. (
        2026051809 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0309.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.189.32
@       IN  TXT     "env=prod;dept=rnd"
intranet    IN  A       10.10.194.37
intranet    IN  A       10.10.12.76
portal    IN  A       10.10.156.164
_info.portal IN TXT "service=portal;ttl=60"
login    IN  A       10.10.130.80
login    IN  A       10.10.203.119
test    IN  CNAME   www.domain0309.test.
www IN  A       10.10.222.108
mail    IN  A       10.10.238.54
_info.mail IN TXT "service=mail;ttl=60"
mail    IN  A       10.10.70.192
@       IN  MX 10   mail.domain0309.test.
