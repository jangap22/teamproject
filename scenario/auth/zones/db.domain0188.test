$TTL 600
@   IN  SOA ns1.domain0188.test. admin.domain0188.test. (
        2026051888 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0188.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.199.44
@       IN  TXT     "env=test;dept=rnd"
admin    IN  A       10.10.107.93
_info.admin IN TXT "service=admin;ttl=600"
dev    IN  A       10.10.207.125
dev    IN  A       10.10.27.163
