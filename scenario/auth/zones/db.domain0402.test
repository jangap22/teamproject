$TTL 300
@   IN  SOA ns1.domain0402.test. admin.domain0402.test. (
        2026051802 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0402.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.212.182
@       IN  TXT     "env=test;dept=infra"
test    IN  A       10.10.241.208
_info.test IN TXT "service=test;ttl=300"
dev    IN  A       10.10.73.52
_info.dev IN TXT "service=dev;ttl=300"
admin    IN  A       10.10.237.18
_info.admin IN TXT "service=admin;ttl=300"
