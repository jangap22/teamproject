admin    IN  CNAME   intranet.domain0139.test.
intranet IN  A       10.10.101.33
api    IN  A       10.10.134.39
_info.api IN TXT "service=api;ttl=120"
login    IN  A       10.10.207.197
login    IN  A       10.10.27.237
portal    IN  A       10.10.253.250
_info.portal IN TXT "service=portal;ttl=120"
mail    IN  CNAME   intranet.domain0139.test.
intranet IN  A       10.10.153.19
www    IN  A       10.10.203.11
_info.www IN TXT "service=www;ttl=120"
test    IN  A       10.10.8.241
_info.test IN TXT "service=test;ttl=120"
