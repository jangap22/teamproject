$TTL 600
@   IN  SOA ns1.domain0472.test. admin.domain0472.test. (
        2026051872 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0472.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.98.189
@       IN  TXT     "env=test;dept=rnd"
login    IN  A       10.10.86.38
_info.login IN TXT "service=login;ttl=600"
portal    IN  A       10.10.30.86
_info.portal IN TXT "service=portal;ttl=600"
dev    IN  A       10.10.146.189
_info.dev IN TXT "service=dev;ttl=600"
bank    IN  CNAME   intranet.domain0472.test.
intranet IN  A       10.10.134.32
www    IN  A       10.10.6.201
intranet    IN  CNAME   portal.domain0472.test.
portal IN  A       10.10.209.242
mail    IN  A       10.10.126.136
@       IN  MX 10   mail.domain0472.test.
