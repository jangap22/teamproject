$TTL 600
@   IN  SOA ns1.domain0576.test. admin.domain0576.test. (
        2026051876 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0576.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.185.179
@       IN  TXT     "env=prod;dept=security"
bank    IN  A       10.10.117.54
_info.bank IN TXT "service=bank;ttl=600"
www    IN  A       10.10.236.33
admin    IN  A       10.10.26.117
test    IN  CNAME   intranet.domain0576.test.
intranet IN  A       10.10.70.157
