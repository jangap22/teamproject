$TTL 600
@   IN  SOA ns1.domain0655.test. admin.domain0655.test. (
        2026051855 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0655.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.121.74
@       IN  TXT     "env=stage;dept=rnd"
bank    IN  A       10.10.238.253
mail    IN  A       10.10.195.202
_info.mail IN TXT "service=mail;ttl=600"
