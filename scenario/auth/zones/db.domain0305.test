_info.admin IN TXT "service=admin;ttl=120"
dev    IN  A       10.10.180.219
dev    IN  A       10.10.254.3
test    IN  CNAME   intranet.domain0305.test.
intranet IN  A       10.10.92.253
intranet    IN  A       10.10.74.172
intranet    IN  A       10.10.147.210
www    IN  A       10.10.133.224
www    IN  A       10.10.207.9
portal    IN  CNAME   www.domain0305.test.
