$TTL 60
@   IN  SOA ns1.domain0527.test. admin.domain0527.test. (
        2026051827 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0527.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.10.153
@       IN  TXT     "env=prod;dept=finance"
test    IN  A       10.10.248.143
_info.test IN TXT "service=test;ttl=60"
api    IN  A       10.10.61.18
login    IN  CNAME   portal.domain0527.test.
portal IN  A       10.10.75.110
admin    IN  CNAME   intranet.domain0527.test.
intranet IN  A       10.10.162.186
