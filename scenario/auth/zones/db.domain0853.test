$TTL 300
@   IN  SOA ns1.domain0853.test. admin.domain0853.test. (
        2026051853 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0853.test.
ns1     IN  A       10.10.10.53
