www IN  A       10.10.183.15
www    IN  A       10.10.132.158
_info.www IN TXT "service=www;ttl=300"
portal    IN  A       10.10.91.233
_info.portal IN TXT "service=portal;ttl=300"
login    IN  A       10.10.231.209
bank    IN  A       10.10.169.48
