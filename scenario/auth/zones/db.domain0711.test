$TTL 60
@   IN  SOA ns1.domain0711.test. admin.domain0711.test. (
        2026051811 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0711.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.125.78
@       IN  TXT     "env=dev;dept=rnd"
dev    IN  A       10.10.63.36
_info.dev IN TXT "service=dev;ttl=60"
test    IN  A       10.10.236.100
_info.test IN TXT "service=test;ttl=60"
intranet    IN  A       10.10.6.80
www    IN  A       10.10.228.120
www    IN  A       10.10.48.159
mail    IN  A       10.10.154.122
@       IN  MX 10   mail.domain0711.test.
