$TTL 120
@   IN  SOA ns1.domain0002.test. admin.domain0002.test. (
        2026051802 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0002.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.213.21
@       IN  TXT     "env=test;dept=hr"
mail    IN  A       10.10.38.68
_info.mail IN TXT "service=mail;ttl=120"
portal    IN  CNAME   www.domain0002.test.
www IN  A       10.10.79.160
www    IN  A       10.10.200.230
