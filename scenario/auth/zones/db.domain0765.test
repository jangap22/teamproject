$TTL 600
@   IN  SOA ns1.domain0765.test. admin.domain0765.test. (
        2026051865 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0765.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.192.164
@       IN  TXT     "env=test;dept=hr"
portal    IN  A       10.10.170.172
dev    IN  A       10.10.173.66
_info.dev IN TXT "service=dev;ttl=600"
mail    IN  A       10.10.137.116
@       IN  MX 10   mail.domain0765.test.
