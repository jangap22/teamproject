$TTL 120
@   IN  SOA ns1.domain0890.test. admin.domain0890.test. (
        2026051890 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0890.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.225.133
