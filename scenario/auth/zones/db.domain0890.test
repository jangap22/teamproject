dev    IN  A       10.10.120.87
dev    IN  A       10.10.192.126
mail    IN  A       10.10.99.80
_info.mail IN TXT "service=mail;ttl=120"
login    IN  A       10.10.121.116
login    IN  A       10.10.193.154
intranet    IN  CNAME   intranet.domain0890.test.
intranet IN  A       10.10.116.39
