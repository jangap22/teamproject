$TTL 1800
@   IN  SOA ns1.domain0528.test. admin.domain0528.test. (
        2026051828 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0528.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.107.183
@       IN  TXT     "env=stage;dept=infra"
admin    IN  A       10.10.246.174
api    IN  A       10.10.4.191
_info.api IN TXT "service=api;ttl=1800"
bank    IN  A       10.10.89.52
_info.bank IN TXT "service=bank;ttl=1800"
www    IN  A       10.10.17.202
_info.www IN TXT "service=www;ttl=1800"
login    IN  A       10.10.235.220
_info.login IN TXT "service=login;ttl=1800"
intranet    IN  CNAME   portal.domain0528.test.
portal IN  A       10.10.138.130
mail    IN  A       10.10.150.155
@       IN  MX 10   mail.domain0528.test.
