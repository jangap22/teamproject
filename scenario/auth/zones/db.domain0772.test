mail    IN  CNAME   intranet.domain0772.test.
intranet IN  A       10.10.38.162
admin    IN  A       10.10.141.176
admin    IN  A       10.10.215.215
login    IN  A       10.10.43.154
_info.login IN TXT "service=login;ttl=120"
intranet    IN  CNAME   portal.domain0772.test.
portal IN  A       10.10.121.237
bank    IN  CNAME   www.domain0772.test.
www IN  A       10.10.52.51
