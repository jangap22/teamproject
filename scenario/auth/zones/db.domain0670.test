$TTL 120
@   IN  SOA ns1.domain0670.test. admin.domain0670.test. (
        2026051870 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0670.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.251.188
@       IN  TXT     "env=dev;dept=infra"
intranet    IN  A       10.10.111.203
intranet    IN  A       10.10.184.242
api    IN  A       10.10.100.4
api    IN  A       10.10.174.45
test    IN  A       10.10.4.247
_info.test IN TXT "service=test;ttl=120"
login    IN  A       10.10.167.142
_info.login IN TXT "service=login;ttl=120"
www    IN  A       10.10.50.246
www    IN  A       10.10.122.33
mail    IN  A       10.10.42.252
@       IN  MX 10   mail.domain0670.test.
