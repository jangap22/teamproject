$TTL 300
@   IN  SOA ns1.domain0458.test. admin.domain0458.test. (
        2026051858 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0458.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.167.3
@       IN  TXT     "env=test;dept=finance"
dev    IN  CNAME   intranet.domain0458.test.
intranet IN  A       10.10.220.189
api    IN  CNAME   intranet.domain0458.test.
intranet IN  A       10.10.42.120
admin    IN  A       10.10.74.4
_info.admin IN TXT "service=admin;ttl=300"
mail    IN  A       10.10.165.81
@       IN  MX 10   mail.domain0458.test.
