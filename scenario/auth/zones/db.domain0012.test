$TTL 120
@   IN  SOA ns1.domain0012.test. admin.domain0012.test. (
        2026051812 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0012.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.225.75
@       IN  TXT     "env=dev;dept=hr"
login    IN  A       10.10.211.209
_info.login IN TXT "service=login;ttl=120"
admin    IN  A       10.10.234.138
admin    IN  A       10.10.52.176
www    IN  A       10.10.123.207
test    IN  A       10.10.180.239
intranet    IN  A       10.10.26.12
intranet    IN  A       10.10.100.53
mail    IN  A       10.10.120.132
@       IN  MX 10   mail.domain0012.test.
