$TTL 1800
@   IN  SOA ns1.domain0255.test. admin.domain0255.test. (
        2026051855 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0255.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.30.247
@       IN  TXT     "env=stage;dept=infra"
api    IN  A       10.10.125.230
api    IN  A       10.10.199.16
admin    IN  A       10.10.117.238
mail    IN  A       10.10.153.191
_info.mail IN TXT "service=mail;ttl=1800"
test    IN  A       10.10.172.88
login    IN  A       10.10.137.173
_info.login IN TXT "service=login;ttl=1800"
dev    IN  A       10.10.110.131
dev    IN  A       10.10.182.171
