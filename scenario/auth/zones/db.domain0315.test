_info.login IN TXT "service=login;ttl=60"
dev    IN  CNAME   portal.domain0315.test.
portal IN  A       10.10.228.132
admin    IN  A       10.10.125.131
mail    IN  A       10.10.10.212
mail    IN  A       10.10.84.253
bank    IN  A       10.10.192.219
bank    IN  A       10.10.13.6
mail    IN  A       10.10.228.162
