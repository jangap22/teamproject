$TTL 1800
@   IN  SOA ns1.domain0733.test. admin.domain0733.test. (
        2026051833 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0733.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.64.144
@       IN  TXT     "env=dev;dept=rnd"
bank    IN  A       10.10.201.119
_info.bank IN TXT "service=bank;ttl=1800"
intranet    IN  A       10.10.220.92
_info.intranet IN TXT "service=intranet;ttl=1800"
api    IN  A       10.10.4.49
mail    IN  A       10.10.208.227
@       IN  MX 10   mail.domain0733.test.
