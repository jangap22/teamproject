$TTL 1800
@   IN  SOA ns1.domain0462.test. admin.domain0462.test. (
        2026051862 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0462.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.52.74
@       IN  TXT     "env=prod;dept=sales"
test    IN  A       10.10.50.128
admin    IN  A       10.10.233.177
intranet    IN  A       10.10.96.204
_info.intranet IN TXT "service=intranet;ttl=1800"
portal    IN  A       10.10.193.26
_info.portal IN TXT "service=portal;ttl=1800"
login    IN  A       10.10.154.218
mail    IN  A       10.10.120.98
@       IN  MX 10   mail.domain0462.test.
