$TTL 120
@   IN  SOA ns1.domain0175.test. admin.domain0175.test. (
        2026051875 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0175.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.225.216
@       IN  TXT     "env=test;dept=hr"
intranet    IN  A       10.10.253.234
_info.intranet IN TXT "service=intranet;ttl=120"
login    IN  A       10.10.38.121
_info.login IN TXT "service=login;ttl=120"
portal    IN  A       10.10.246.66
_info.portal IN TXT "service=portal;ttl=120"
www    IN  A       10.10.5.143
www    IN  A       10.10.77.181
dev    IN  A       10.10.42.234
_info.dev IN TXT "service=dev;ttl=120"
mail    IN  A       10.10.50.208
@       IN  MX 10   mail.domain0175.test.
