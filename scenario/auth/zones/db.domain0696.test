$TTL 1800
@   IN  SOA ns1.domain0696.test. admin.domain0696.test. (
        2026051896 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0696.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.130.48
@       IN  TXT     "env=prod;dept=security"
dev    IN  A       10.10.190.178
dev    IN  A       10.10.8.217
login    IN  A       10.10.122.161
_info.login IN TXT "service=login;ttl=1800"
www    IN  CNAME   www.domain0696.test.
www IN  A       10.10.27.65
mail    IN  A       10.10.100.176
@       IN  MX 10   mail.domain0696.test.
