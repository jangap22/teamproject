$TTL 300
@   IN  SOA ns1.domain0510.test. admin.domain0510.test. (
        2026051810 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0510.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.28.29
