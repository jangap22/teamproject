admin    IN  A       10.10.227.172
test    IN  CNAME   www.domain0510.test.
www IN  A       10.10.132.89
www    IN  A       10.10.80.150
_info.www IN TXT "service=www;ttl=300"
mail    IN  A       10.10.208.147
api    IN  A       10.10.19.71
api    IN  A       10.10.91.112
mail    IN  A       10.10.83.17
@       IN  MX 10   mail.domain0510.test.
