admin    IN  A       10.10.234.16
test    IN  A       10.10.81.41
_info.test IN TXT "service=test;ttl=1800"
dev    IN  A       10.10.174.16
dev    IN  A       10.10.246.57
www    IN  A       10.10.37.87
www    IN  A       10.10.109.128
login    IN  A       10.10.209.46
_info.login IN TXT "service=login;ttl=1800"
mail    IN  A       10.10.195.229
@       IN  MX 10   mail.domain0669.test.
