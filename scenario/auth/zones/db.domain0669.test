$TTL 1800
@   IN  SOA ns1.domain0669.test. admin.domain0669.test. (
        2026051869 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0669.test.
