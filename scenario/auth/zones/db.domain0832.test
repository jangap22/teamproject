_info.test IN TXT "service=test;ttl=120"
api    IN  CNAME   portal.domain0832.test.
portal IN  A       10.10.169.1
bank    IN  CNAME   portal.domain0832.test.
portal IN  A       10.10.74.27
mail    IN  CNAME   www.domain0832.test.
