$TTL 120
@   IN  SOA ns1.domain0654.test. admin.domain0654.test. (
        2026051854 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0654.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.131.238
@       IN  TXT     "env=test;dept=infra"
www    IN  CNAME   www.domain0654.test.
www IN  A       10.10.95.23
mail    IN  A       10.10.116.135
_info.mail IN TXT "service=mail;ttl=120"
api    IN  A       10.10.41.169
api    IN  A       10.10.114.209
mail    IN  A       10.10.142.139
@       IN  MX 10   mail.domain0654.test.
