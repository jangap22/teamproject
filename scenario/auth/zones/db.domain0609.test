dev    IN  A       10.10.252.139
dev    IN  A       10.10.70.179
bank    IN  CNAME   intranet.domain0609.test.
intranet IN  A       10.10.165.40
portal    IN  A       10.10.127.49
_info.portal IN TXT "service=portal;ttl=600"
