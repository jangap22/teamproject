$TTL 300
@   IN  SOA ns1.domain0867.test. admin.domain0867.test. (
        2026051867 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0867.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.56.37
@       IN  TXT     "env=stage;dept=security"
portal    IN  A       10.10.153.93
dev    IN  A       10.10.166.80
_info.dev IN TXT "service=dev;ttl=300"
login    IN  A       10.10.112.164
_info.login IN TXT "service=login;ttl=300"
bank    IN  CNAME   portal.domain0867.test.
portal IN  A       10.10.5.23
mail    IN  A       10.10.72.230
@       IN  MX 10   mail.domain0867.test.
