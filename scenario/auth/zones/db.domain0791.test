$TTL 300
@   IN  SOA ns1.domain0791.test. admin.domain0791.test. (
        2026051891 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0791.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.100.80
@       IN  TXT     "env=stage;dept=security"
admin    IN  A       10.10.197.2
_info.admin IN TXT "service=admin;ttl=300"
login    IN  A       10.10.8.45
_info.login IN TXT "service=login;ttl=300"
portal    IN  A       10.10.116.2
test    IN  A       10.10.141.122
www    IN  A       10.10.75.156
_info.www IN TXT "service=www;ttl=300"
