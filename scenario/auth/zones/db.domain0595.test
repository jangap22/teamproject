$TTL 1800
@   IN  SOA ns1.domain0595.test. admin.domain0595.test. (
        2026051895 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0595.test.
