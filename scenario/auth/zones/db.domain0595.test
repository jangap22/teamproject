mail    IN  A       10.10.86.129
_info.mail IN TXT "service=mail;ttl=1800"
dev    IN  CNAME   www.domain0595.test.
www IN  A       10.10.124.16
portal    IN  A       10.10.40.141
portal    IN  A       10.10.114.180
bank    IN  A       10.10.51.58
www    IN  A       10.10.250.107
login    IN  A       10.10.113.69
