$TTL 60
@   IN  SOA ns1.domain0226.test. admin.domain0226.test. (
        2026051826 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0226.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.100.107
@       IN  TXT     "env=test;dept=infra"
intranet    IN  CNAME   intranet.domain0226.test.
intranet IN  A       10.10.178.175
api    IN  A       10.10.218.124
_info.api IN TXT "service=api;ttl=60"
bank    IN  CNAME   intranet.domain0226.test.
intranet IN  A       10.10.53.128
login    IN  CNAME   www.domain0226.test.
www IN  A       10.10.157.138
test    IN  A       10.10.197.157
_info.test IN TXT "service=test;ttl=60"
mail    IN  A       10.10.210.225
@       IN  MX 10   mail.domain0226.test.
