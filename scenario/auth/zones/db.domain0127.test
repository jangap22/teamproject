login    IN  A       10.10.86.241
mail    IN  A       10.10.122.19
mail    IN  A       10.10.194.57
portal    IN  A       10.10.214.18
portal    IN  A       10.10.32.58
admin    IN  A       10.10.60.55
dev    IN  A       10.10.124.201
