$TTL 60
@   IN  SOA ns1.domain0200.test. admin.domain0200.test. (
        2026051800 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0200.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.172.94
@       IN  TXT     "env=prod;dept=finance"
www    IN  A       10.10.70.119
dev    IN  A       10.10.18.205
mail    IN  A       10.10.172.251
api    IN  A       10.10.30.108
api    IN  A       10.10.105.148
test    IN  A       10.10.100.220
_info.test IN TXT "service=test;ttl=60"
mail    IN  A       10.10.21.203
@       IN  MX 10   mail.domain0200.test.
