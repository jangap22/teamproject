portal IN  A       10.10.21.40
test    IN  A       10.10.240.192
_info.test IN TXT "service=test;ttl=600"
api    IN  A       10.10.204.134
_info.api IN TXT "service=api;ttl=600"
login    IN  A       10.10.214.89
login    IN  A       10.10.34.128
