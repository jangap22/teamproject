$TTL 600
@   IN  SOA ns1.domain0061.test. admin.domain0061.test. (
        2026051861 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0061.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.69.175
@       IN  TXT     "env=test;dept=finance"
www    IN  A       10.10.28.57
_info.www IN TXT "service=www;ttl=600"
dev    IN  A       10.10.21.247
portal    IN  A       10.10.25.117
portal    IN  A       10.10.97.155
mail    IN  A       10.10.216.67
@       IN  MX 10   mail.domain0061.test.
