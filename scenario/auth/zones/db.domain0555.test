$TTL 1800
@   IN  SOA ns1.domain0555.test. admin.domain0555.test. (
        2026051855 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0555.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.203.132
@       IN  TXT     "env=dev;dept=infra"
test    IN  A       10.10.82.33
_info.test IN TXT "service=test;ttl=1800"
bank    IN  A       10.10.206.168
_info.bank IN TXT "service=bank;ttl=1800"
admin    IN  A       10.10.156.176
_info.admin IN TXT "service=admin;ttl=1800"
portal    IN  A       10.10.230.246
api    IN  CNAME   www.domain0555.test.
www IN  A       10.10.187.234
login    IN  CNAME   www.domain0555.test.
www IN  A       10.10.23.136
