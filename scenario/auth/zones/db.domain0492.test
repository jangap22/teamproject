$TTL 120
@   IN  SOA ns1.domain0492.test. admin.domain0492.test. (
        2026051892 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0492.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.17.126
@       IN  TXT     "env=dev;dept=infra"
mail    IN  A       10.10.127.180
mail    IN  A       10.10.202.220
api    IN  A       10.10.123.34
_info.api IN TXT "service=api;ttl=120"
dev    IN  CNAME   www.domain0492.test.
www IN  A       10.10.253.236
intranet    IN  A       10.10.16.250
intranet    IN  A       10.10.162.75
test    IN  A       10.10.85.139
_info.test IN TXT "service=test;ttl=120"
mail    IN  A       10.10.142.61
@       IN  MX 10   mail.domain0492.test.
