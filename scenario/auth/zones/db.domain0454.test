$TTL 600
@   IN  SOA ns1.domain0454.test. admin.domain0454.test. (
        2026051854 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0454.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.252.50
@       IN  TXT     "env=stage;dept=finance"
login    IN  A       10.10.79.158
mail    IN  A       10.10.230.191
_info.mail IN TXT "service=mail;ttl=600"
