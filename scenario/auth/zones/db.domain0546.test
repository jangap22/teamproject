$TTL 120
@   IN  SOA ns1.domain0546.test. admin.domain0546.test. (
        2026051846 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0546.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.24.91
@       IN  TXT     "env=stage;dept=sales"
www    IN  A       10.10.182.47
www    IN  A       10.10.254.87
mail    IN  CNAME   portal.domain0546.test.
portal IN  A       10.10.243.34
admin    IN  A       10.10.109.26
_info.admin IN TXT "service=admin;ttl=120"
dev    IN  A       10.10.89.221
_info.dev IN TXT "service=dev;ttl=120"
mail    IN  A       10.10.23.136
@       IN  MX 10   mail.domain0546.test.
