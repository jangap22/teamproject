api    IN  CNAME   www.domain0895.test.
www IN  A       10.10.162.108
intranet    IN  A       10.10.235.10
_info.intranet IN TXT "service=intranet;ttl=600"
dev    IN  A       10.10.204.179
www    IN  CNAME   portal.domain0895.test.
portal IN  A       10.10.81.165
mail    IN  A       10.10.56.96
@       IN  MX 10   mail.domain0895.test.
