$TTL 600
@   IN  SOA ns1.domain0895.test. admin.domain0895.test. (
        2026051895 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0895.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.134.133
