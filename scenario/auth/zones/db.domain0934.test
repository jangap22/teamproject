$TTL 120
@   IN  SOA ns1.domain0934.test. admin.domain0934.test. (
        2026051834 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0934.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.43.39
@       IN  TXT     "env=prod;dept=security"
dev    IN  A       10.10.104.222
_info.dev IN TXT "service=dev;ttl=120"
intranet    IN  CNAME   portal.domain0934.test.
portal IN  A       10.10.165.134
www    IN  CNAME   www.domain0934.test.
www IN  A       10.10.98.235
mail    IN  A       10.10.226.163
_info.mail IN TXT "service=mail;ttl=120"
