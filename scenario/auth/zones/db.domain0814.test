$TTL 1800
@   IN  SOA ns1.domain0814.test. admin.domain0814.test. (
        2026051814 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0814.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.99.49
@       IN  TXT     "env=dev;dept=hr"
intranet    IN  CNAME   intranet.domain0814.test.
intranet IN  A       10.10.111.9
bank    IN  A       10.10.129.92
_info.bank IN TXT "service=bank;ttl=1800"
portal    IN  A       10.10.98.138
_info.portal IN TXT "service=portal;ttl=1800"
mail    IN  A       10.10.171.252
@       IN  MX 10   mail.domain0814.test.
