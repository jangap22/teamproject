$TTL 300
@   IN  SOA ns1.domain0518.test. admin.domain0518.test. (
        2026051818 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0518.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.6.172
@       IN  TXT     "env=stage;dept=security"
login    IN  A       10.10.142.207
_info.login IN TXT "service=login;ttl=300"
intranet    IN  A       10.10.207.105
mail    IN  A       10.10.172.125
@       IN  MX 10   mail.domain0518.test.
