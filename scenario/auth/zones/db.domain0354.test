$TTL 60
@   IN  SOA ns1.domain0354.test. admin.domain0354.test. (
        2026051854 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0354.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.238.241
@       IN  TXT     "env=dev;dept=security"
login    IN  A       10.10.101.138
login    IN  A       10.10.176.179
portal    IN  A       10.10.70.166
portal    IN  A       10.10.142.205
mail    IN  A       10.10.17.85
_info.mail IN TXT "service=mail;ttl=60"
admin    IN  A       10.10.179.34
_info.admin IN TXT "service=admin;ttl=60"
www    IN  A       10.10.16.47
