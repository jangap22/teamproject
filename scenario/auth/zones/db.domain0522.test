$TTL 300
@   IN  SOA ns1.domain0522.test. admin.domain0522.test. (
        2026051822 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0522.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.192.89
@       IN  TXT     "env=test;dept=infra"
mail    IN  CNAME   www.domain0522.test.
www IN  A       10.10.88.62
api    IN  CNAME   intranet.domain0522.test.
intranet IN  A       10.10.87.218
admin    IN  A       10.10.17.205
_info.admin IN TXT "service=admin;ttl=300"
login    IN  A       10.10.71.222
_info.login IN TXT "service=login;ttl=300"
portal    IN  A       10.10.155.186
_info.portal IN TXT "service=portal;ttl=300"
intranet    IN  A       10.10.187.200
mail    IN  A       10.10.193.24
@       IN  MX 10   mail.domain0522.test.
