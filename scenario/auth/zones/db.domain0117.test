$TTL 1800
@   IN  SOA ns1.domain0117.test. admin.domain0117.test. (
        2026051817 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0117.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.182.178
@       IN  TXT     "env=test;dept=sales"
bank    IN  A       10.10.87.240
login    IN  A       10.10.1.163
_info.login IN TXT "service=login;ttl=1800"
api    IN  A       10.10.247.234
api    IN  A       10.10.67.18
mail    IN  CNAME   intranet.domain0117.test.
intranet IN  A       10.10.23.217
www    IN  A       10.10.250.176
_info.www IN TXT "service=www;ttl=1800"
