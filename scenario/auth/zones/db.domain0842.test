_info.login IN TXT "service=login;ttl=1800"
api    IN  A       10.10.166.183
_info.api IN TXT "service=api;ttl=1800"
dev    IN  A       10.10.151.169
bank    IN  A       10.10.204.177
_info.bank IN TXT "service=bank;ttl=1800"
www    IN  CNAME   portal.domain0842.test.
portal IN  A       10.10.172.216
portal    IN  CNAME   intranet.domain0842.test.
