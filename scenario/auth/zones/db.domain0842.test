$TTL 1800
@   IN  SOA ns1.domain0842.test. admin.domain0842.test. (
        2026051842 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0842.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.161.161
