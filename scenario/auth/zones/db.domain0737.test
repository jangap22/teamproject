$TTL 120
@   IN  SOA ns1.domain0737.test. admin.domain0737.test. (
        2026051837 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0737.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.239.105
@       IN  TXT     "env=test;dept=hr"
login    IN  CNAME   www.domain0737.test.
www IN  A       10.10.57.49
intranet    IN  CNAME   www.domain0737.test.
www IN  A       10.10.23.62
portal    IN  A       10.10.210.194
_info.portal IN TXT "service=portal;ttl=120"
api    IN  CNAME   www.domain0737.test.
www IN  A       10.10.150.138
mail    IN  A       10.10.49.169
@       IN  MX 10   mail.domain0737.test.
