mail    IN  A       10.10.121.88
_info.mail IN TXT "service=mail;ttl=600"
api    IN  CNAME   intranet.domain0823.test.
intranet IN  A       10.10.56.90
www    IN  CNAME   www.domain0823.test.
www IN  A       10.10.13.194
mail    IN  A       10.10.64.153
@       IN  MX 10   mail.domain0823.test.
