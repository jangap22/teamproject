portal    IN  CNAME   www.domain0106.test.
www IN  A       10.10.223.192
intranet    IN  A       10.10.123.55
intranet    IN  A       10.10.195.96
dev    IN  CNAME   portal.domain0106.test.
portal IN  A       10.10.200.170
test    IN  A       10.10.49.16
test    IN  A       10.10.122.55
bank    IN  A       10.10.36.65
_info.bank IN TXT "service=bank;ttl=60"
api    IN  CNAME   www.domain0106.test.
www IN  A       10.10.186.82
admin    IN  A       10.10.232.119
_info.admin IN TXT "service=admin;ttl=60"
