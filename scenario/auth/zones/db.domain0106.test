$TTL 60
@   IN  SOA ns1.domain0106.test. admin.domain0106.test. (
        2026051806 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0106.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.137.26
