$TTL 1800
@   IN  SOA ns1.domain0697.test. admin.domain0697.test. (
        2026051897 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0697.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.159.55
