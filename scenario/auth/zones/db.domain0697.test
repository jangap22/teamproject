www    IN  A       10.10.144.35
_info.www IN TXT "service=www;ttl=1800"
portal    IN  A       10.10.5.23
_info.portal IN TXT "service=portal;ttl=1800"
intranet    IN  CNAME   portal.domain0697.test.
portal IN  A       10.10.133.26
dev    IN  A       10.10.240.68
_info.dev IN TXT "service=dev;ttl=1800"
admin    IN  A       10.10.54.136
admin    IN  A       10.10.128.174
mail    IN  CNAME   www.domain0697.test.
www IN  A       10.10.82.66
