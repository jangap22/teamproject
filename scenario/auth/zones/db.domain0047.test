$TTL 300
@   IN  SOA ns1.domain0047.test. admin.domain0047.test. (
        2026051847 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0047.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.237.241
@       IN  TXT     "env=test;dept=infra"
portal    IN  A       10.10.62.111
portal    IN  A       10.10.136.150
login    IN  CNAME   intranet.domain0047.test.
intranet IN  A       10.10.86.204
admin    IN  A       10.10.88.57
_info.admin IN TXT "service=admin;ttl=300"
dev    IN  A       10.10.80.97
