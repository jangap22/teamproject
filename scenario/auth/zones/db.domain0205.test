$TTL 120
@   IN  SOA ns1.domain0205.test. admin.domain0205.test. (
        2026051805 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0205.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.28.213
@       IN  TXT     "env=prod;dept=security"
mail    IN  CNAME   portal.domain0205.test.
portal IN  A       10.10.103.124
admin    IN  A       10.10.211.107
dev    IN  CNAME   www.domain0205.test.
www IN  A       10.10.82.161
api    IN  CNAME   intranet.domain0205.test.
intranet IN  A       10.10.235.40
mail    IN  A       10.10.143.151
@       IN  MX 10   mail.domain0205.test.
