$TTL 120
@   IN  SOA ns1.domain0101.test. admin.domain0101.test. (
        2026051801 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0101.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.101.80
@       IN  TXT     "env=prod;dept=rnd"
portal    IN  A       10.10.34.91
_info.portal IN TXT "service=portal;ttl=120"
www    IN  A       10.10.243.115
_info.www IN TXT "service=www;ttl=120"
mail    IN  A       10.10.80.49
_info.mail IN TXT "service=mail;ttl=120"
admin    IN  CNAME   intranet.domain0101.test.
intranet IN  A       10.10.155.195
login    IN  CNAME   portal.domain0101.test.
portal IN  A       10.10.220.173
mail    IN  A       10.10.113.96
@       IN  MX 10   mail.domain0101.test.
