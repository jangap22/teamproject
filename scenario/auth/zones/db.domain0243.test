$TTL 300
@   IN  SOA ns1.domain0243.test. admin.domain0243.test. (
        2026051843 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        300 )   ; minimum

@       IN  NS      ns1.domain0243.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.197.150
@       IN  TXT     "env=prod;dept=rnd"
login    IN  A       10.10.73.234
_info.login IN TXT "service=login;ttl=300"
api    IN  A       10.10.245.118
_info.api IN TXT "service=api;ttl=300"
test    IN  CNAME   portal.domain0243.test.
portal IN  A       10.10.229.175
admin    IN  CNAME   portal.domain0243.test.
portal IN  A       10.10.134.247
portal    IN  CNAME   www.domain0243.test.
www IN  A       10.10.53.26
mail    IN  A       10.10.113.95
_info.mail IN TXT "service=mail;ttl=300"
