$TTL 120
@   IN  SOA ns1.domain0053.test. admin.domain0053.test. (
        2026051853 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0053.test.
ns1     IN  A       10.10.10.53
