$TTL 60
@   IN  SOA ns1.domain0421.test. admin.domain0421.test. (
        2026051821 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0421.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.39.203
@       IN  TXT     "env=prod;dept=finance"
intranet    IN  A       10.10.16.176
_info.intranet IN TXT "service=intranet;ttl=60"
api    IN  CNAME   portal.domain0421.test.
portal IN  A       10.10.227.23
login    IN  A       10.10.100.135
_info.login IN TXT "service=login;ttl=60"
mail    IN  A       10.10.207.199
@       IN  MX 10   mail.domain0421.test.
