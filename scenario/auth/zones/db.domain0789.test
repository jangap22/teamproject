_info.test IN TXT "service=test;ttl=300"
login    IN  A       10.10.135.211
intranet    IN  A       10.10.135.204
intranet    IN  A       10.10.209.243
api    IN  A       10.10.16.175
api    IN  A       10.10.90.215
bank    IN  A       10.10.88.133
_info.bank IN TXT "service=bank;ttl=300"
