$TTL 120
@   IN  SOA ns1.domain0681.test. admin.domain0681.test. (
        2026051881 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0681.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.28.89
@       IN  TXT     "env=dev;dept=infra"
bank    IN  CNAME   www.domain0681.test.
www IN  A       10.10.13.57
api    IN  A       10.10.230.201
_info.api IN TXT "service=api;ttl=120"
login    IN  A       10.10.191.2
test    IN  A       10.10.58.253
_info.test IN TXT "service=test;ttl=120"
intranet    IN  CNAME   portal.domain0681.test.
portal IN  A       10.10.195.244
portal    IN  A       10.10.33.197
mail    IN  A       10.10.195.2
@       IN  MX 10   mail.domain0681.test.
