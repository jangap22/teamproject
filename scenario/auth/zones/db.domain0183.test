$TTL 60
@   IN  SOA ns1.domain0183.test. admin.domain0183.test. (
        2026051883 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        60 )   ; minimum

@       IN  NS      ns1.domain0183.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.4.155
@       IN  TXT     "env=prod;dept=security"
admin    IN  CNAME   www.domain0183.test.
www IN  A       10.10.246.111
login    IN  A       10.10.178.166
login    IN  A       10.10.253.207
mail    IN  A       10.10.121.22
@       IN  MX 10   mail.domain0183.test.
