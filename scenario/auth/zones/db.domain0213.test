$TTL 600
@   IN  SOA ns1.domain0213.test. admin.domain0213.test. (
        2026051813 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        600 )   ; minimum

@       IN  NS      ns1.domain0213.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.248.148
@       IN  TXT     "env=prod;dept=finance"
admin    IN  A       10.10.202.101
admin    IN  A       10.10.21.142
www    IN  A       10.10.204.115
_info.www IN TXT "service=www;ttl=600"
test    IN  A       10.10.65.179
mail    IN  A       10.10.84.117
@       IN  MX 10   mail.domain0213.test.
