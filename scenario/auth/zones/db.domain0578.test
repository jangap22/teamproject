$TTL 120
@   IN  SOA ns1.domain0578.test. admin.domain0578.test. (
        2026051878 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        120 )   ; minimum

@       IN  NS      ns1.domain0578.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.131.105
@       IN  TXT     "env=test;dept=rnd"
test    IN  A       10.10.179.225
_info.test IN TXT "service=test;ttl=120"
api    IN  CNAME   intranet.domain0578.test.
intranet IN  A       10.10.84.82
bank    IN  A       10.10.223.157
bank    IN  A       10.10.41.196
www    IN  A       10.10.184.97
admin    IN  CNAME   www.domain0578.test.
www IN  A       10.10.225.123
mail    IN  A       10.10.205.104
@       IN  MX 10   mail.domain0578.test.
