$TTL 1800
@   IN  SOA ns1.domain0845.test. admin.domain0845.test. (
        2026051845 ; serial
        300        ; refresh
        180        ; retry
        1209600    ; expire
        1800 )   ; minimum

@       IN  NS      ns1.domain0845.test.
ns1     IN  A       10.10.10.53
@       IN  A       10.10.13.210
@       IN  TXT     "env=test;dept=security"
test    IN  A       10.10.84.94
_info.test IN TXT "service=test;ttl=1800"
bank    IN  A       10.10.70.100
portal    IN  A       10.10.141.109
_info.portal IN TXT "service=portal;ttl=1800"
mail    IN  A       10.10.145.173
@       IN  MX 10   mail.domain0845.test.
